<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="FixtureWixUi" Manufacturer="craft-common-actions test fixture" Version="$(var.Version)" UpgradeCode="3A7303C4-C6ED-45A7-BF54-2C665A89312A" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="FixtureWixUi vector illustration app" Manufacturer="craft-common-actions test fixture" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of FixtureWixUi is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FixtureWixUiIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FixtureWixUiIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://example.invalid/fixturewixui" />
    <Property Id="ARPURLUPDATEINFO" Value="https://example.invalid/fixturewixui" />
    <Property Id="ARPHELPLINK" Value="https://example.invalid/help" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="FixtureWixUi" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- An upgrade installs where the user put the previous version (written by FixtureWixUiApp). -->

    <Feature Id="Main" Title="FixtureWixUi" Level="1">
      <ComponentGroupRef Id="FixtureWixUiFiles" />
      <ComponentGroupRef Id="PdfDocumentation" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- A desktop shortcut: the Shortcuts page's box (ticked), or INSTALLDESKTOPSHORTCUT="" on the
         msiexec command line for none. Secure, so the wizard's choice reaches the install. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <!-- The Shortcuts page sits between the install folder and Ready (once the folder is valid). -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="NOT Installed" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgDescription)" />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="!(loc.ShortcutsDlgDesktop)" />
        <Control Id="StartMenuNote" Type="Text" X="20" Y="84" Width="330" Height="30" NoPrefix="yes" Text="!(loc.ShortcutsDlgStartMenu)" />
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFixtureWixUi" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through fixturewixui.en-us.wxl. -->
    <Property Id="FixtureWixUiVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="FixtureWixUi $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FixtureWixUi" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#FixtureWixUiExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchFixtureWixUi" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="PdfDocumentation" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <ComponentGroup Id="FixtureWixUiFiles" Directory="INSTALLFOLDER">
      <Component Id="FixtureWixUiApp" Guid="B708BB60-D510-472F-AFC1-8B78D19F98FE">
        <File Id="FixtureWixUiExe" Source="$(var.BinDir)\fixturewixui.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FixtureWixUi" Description="FixtureWixUi vector illustration app" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="FixtureWixUiIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fixturewixui.exe" Value="[#FixtureWixUiExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\FixtureWixUi" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />

        <!-- File associations: its own format as the default app, one type under "Open with", and the
             Applications entry. All under HKMU\Software\Classes, which the checker requires. -->
        <ProgId Id="FixtureWixUi.Document" Description="FixtureWixUi Document" Icon="FixtureWixUiExe" IconIndex="0">
          <Extension Id="fixturewixui" ContentType="application/x-fixturewixui">
            <Verb Id="open" Command="Open" TargetFile="FixtureWixUiExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <ProgId Id="FixtureWixUi.Image" Description="Image" Icon="FixtureWixUiExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\FixtureWixUi.Image\shell\open\command" Value="&quot;[#FixtureWixUiExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="FixtureWixUi.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fixturewixui.exe" Name="FriendlyAppName" Value="FixtureWixUi" Type="string" />
      </Component>

      <Component Id="FixtureWixUiCli">
        <File Id="FixtureWixUiCliExe" Source="$(var.BinDir)\fixturewixui-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Installed only with INSTALLDESKTOPSHORTCUT set (the Shortcuts page's box); removed with the
         app. A per-machine install puts it on the common desktop. `wix msi validate` reports ICE38,
         ICE43 and ICE57 for it: they take a desktop shortcut for per-user data, which it isn't here. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="6BD3D8A3-DDBA-4CC1-B124-D184A958268C" Condition="INSTALLDESKTOPSHORTCUT">
      <Shortcut Id="DesktopShortcut" Name="FixtureWixUi" Description="FixtureWixUi vector illustration app" Target="[#FixtureWixUiExe]" WorkingDirectory="INSTALLFOLDER" Icon="FixtureWixUiIcon.ico" IconIndex="0" />
      <RegistryValue Root="HKMU" Key="Software\FixtureWixUi" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
