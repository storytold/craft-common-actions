<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="FixtureSkipsLicence" Manufacturer="craft-common-actions test fixture" Version="$(var.Version)" UpgradeCode="6F094D49-7F70-477B-A7DD-BE9AA1D0025A" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="FixtureSkipsLicence video editor" Manufacturer="craft-common-actions test fixture" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of FixtureSkipsLicence is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FixtureSkipsLicenceIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FixtureSkipsLicenceIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://example.invalid/fixtureskipslicence" />
    <Property Id="ARPURLUPDATEINFO" Value="https://example.invalid/fixtureskipslicence" />
    <Property Id="ARPHELPLINK" Value="https://example.invalid/help" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="FixtureSkipsLicence" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FixtureSkipsLicence" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="FixtureSkipsLicenceFiles" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="FixtureSkipsLicenceFiles" Directory="INSTALLFOLDER">
      <Component Id="FixtureSkipsLicenceApp" Guid="96EB0B25-CF18-4118-B068-D5B01E4AB886">
        <File Id="FixtureSkipsLicenceNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="FixtureSkipsLicenceExe" Source="$(var.BinDir)\fixtureskipslicence.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FixtureSkipsLicence" Description="FixtureSkipsLicence video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="FixtureSkipsLicenceIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fixtureskipslicence.exe" Value="[#FixtureSkipsLicenceExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\FixtureSkipsLicence" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="FixtureSkipsLicenceCli">
        <File Id="FixtureSkipsLicenceCliExe" Source="$(var.BinDir)\fixtureskipslicence-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
