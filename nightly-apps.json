    "photocraft": {
      "default_branch": "main",
      "display_name": "PhotoCraft",
      "entrypoints": {
        "linux-x86_64": {
          "binary": "photocraft",
          "entrypoint": "photocraft"
        },
        "macos-aarch64": {
          "binary": "PhotoCraft Nightly.app/Contents/MacOS/PhotoCraft",
          "entrypoint": "PhotoCraft Nightly.app/Contents/MacOS/PhotoCraft"
        },
        "windows-x86_64": {
          "binary": "photocraft.exe",
          "entrypoint": "photocraft.exe"
        }
      },
      "env_prefix": "PHOTOCRAFT",
      "note": "Photo nightly-v1 Windows x86_64 GUI ZIP, Linux x86_64 GUI tar.gz (OpenPGP detached .asc, stable key) and macOS aarch64 notarized app ZIP, published together in one release. Production signing and publication stay off until the app caller opts in.",
      "repository": "storytold/photocraft",
      "targets": [
        {
          "asset_pattern": "photocraft-{version}-windows-x86_64-nightly.zip",
          "isolation": {
            "associations": "none",
            "package_identity": "ai.storyteller.photocraft.nightly",
            "profile_contract": "nightly",
            "profile_version": 1
          },
          "target": {
            "arch": "x86_64",
            "format": "portable_zip",
            "os": "windows"
          }
        },
        {
          "asset_pattern": "photocraft-{version}-linux-x86_64-nightly.tar.gz",
          "isolation": {
            "associations": "none",
            "package_identity": "ai.storyteller.photocraft.nightly",
