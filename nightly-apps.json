  "apps": {
    "anicraft": {
      "default_branch": "main",
      "display_name": "AniCraft",
      "entrypoints": {
        "linux-x86_64": {
          "binary": "anicraft-bin",
          "entrypoint": "anicraft"
        }
      },
      "env_prefix": "ANICRAFT",
      "note": "AniCraft nightly-v1 Linux x86_64 GUI tar.gz, started through the canonical launcher (anicraft) with anicraft-bin beside it. macOS and Windows need their own admission.",
      "repository": "storytold/anicraft",
      "targets": [
        {
          "asset_pattern": "anicraft-{version}-linux-x86_64-nightly.tar.gz",
          "isolation": {
            "associations": "none",
            "package_identity": "ai.storyteller.anicraft.nightly",
            "profile_contract": "nightly",
            "profile_version": 1
          },
          "target": {
            "arch": "x86_64",
            "format": "tar_gz",
            "os": "linux"
          }
        }
      ]
    },
